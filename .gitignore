# Environments
.env
# Note: .env.example is intentionally NOT ignored — it is the
# committed documentation of every variable the Indexer reads.

# Indexer runtime state (cursor + watchlist + locks). Generated by
# `make run`; never commit.
indexer.state.json
indexer.state.json.lock
indexer.state.json.tmp
indexer.state.watchlist.json
indexer.state.watchlist.json.tmp
# Operator-supplied watchlist seed; environment-specific.
indexer.watchlist.seed.json

# Deployments
# Railway IaC tooling (.railway/package.json and the lockfile ARE
# versioned): installed SDK, and the per-operator cutover undo snapshot
# written by `railway config migrate cutover`.
.railway/node_modules/
.railway/.cac-migration.json

# IDE's
.vscode/*
.idea

# Binaries
/indexer
/ingest
bin/
# AI assistant per-machine state (shared context in .claude/ is versioned)
.claude/settings.local.json
.claude/launch.json
